<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.DroneServicesApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Global font -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Core colors -->
        <item name="colorPrimary">@color/ds_color_accent</item>
        <item name="colorPrimaryVariant">@color/ds_color_accent_dim</item>
        <item name="colorSecondary">@color/ds_color_accent</item>

        <!-- App surfaces -->
        <item name="android:colorBackground">@color/ds_color_background</item>
        <item name="colorSurface">@color/ds_color_surface_primary</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/ds_color_text_primary</item>
        <item name="android:textColorSecondary">@color/ds_color_text_secondary</item>

        <!-- Common Material defaults that help on dark UI -->
        <item name="android:statusBarColor">@color/ds_color_background</item>
        <item name="android:navigationBarColor">@color/ds_color_background</item>

        <!-- Optional: helps Material components pick correct contrast -->
        <item name="colorOnPrimary">@color/ds_color_background</item>
        <item name="colorOnSurface">@color/ds_color_text_primary</item>
        <item name="colorOnBackground">@color/ds_color_text_primary</item>
        <item name="colorControlNormal">@color/ds_color_text_primary</item>
        <item name="editTextStyle">@style/Widget.DroneServices.TextInputEditText</item>
        <item name="textInputStyle">@style/Widget.DroneServices.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.DroneServices.Button.Material.Primary</item>

    </style>

    <style name="Theme.DroneServicesApp.NoActionBar" parent="Theme.DroneServicesApp">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.DroneServicesApp.Startup" parent="Theme.DroneServicesApp.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_startup_logo</item>
    </style>

    <!-- FIXED: removed the stray extra '>' -->

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">0sp</item>
    </style>

    <!-- Optional: keep if used elsewhere -->

</resources>
