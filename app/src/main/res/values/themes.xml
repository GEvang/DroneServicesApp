<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme -->
    <style name="Theme.DroneServicesApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Global font -->
        <item name="android:fontFamily">@font/inter</item>
        <item name="fontFamily">@font/inter</item>

        <!-- Core colors -->
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorPrimaryVariant">@color/accent_gold_dim</item>
        <item name="colorSecondary">@color/accent_gold</item>

        <!-- App surfaces -->
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>

        <!-- Text -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>

        <!-- Common Material defaults that help on dark UI -->
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>

        <!-- Optional: helps Material components pick correct contrast -->
        <item name="colorOnPrimary">@color/bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorControlNormal">@color/text_primary</item>

    </style>

    <style name="Theme.DroneServicesApp.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- FIXED: removed the stray extra '>' -->
    <style name="Theme.DroneServicesApp.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:actionButtonStyle">@style/MyActionButtonStyle</item>
    </style>

    <style name="Theme.DroneServicesApp.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="Toolbar.TitleText" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:textSize">0sp</item>
    </style>

    <style name="MyActionButtonStyle" parent="Widget.AppCompat.ActionButton">
        <item name="android:paddingEnd">30dp</item>
        <item name="android:paddingRight">50dp</item>
        <item name="android:layout_marginRight">50dp</item>
        <item name="android:horizontalSpacing">20dp</item>
    </style>

    <!-- Optional: keep if used elsewhere -->
    <style name="TextStyle">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:layout_marginLeft">2dp</item>
        <item name="android:layout_marginRight">2dp</item>
        <item name="android:textSize">24sp</item>
    </style>

</resources>
