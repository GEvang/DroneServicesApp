<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_workflow_panel"
    style="@style/Widget.DroneServices.Panel.MapRight"
    android:layout_width="@dimen/phone_map_panel_right_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workflow_24"
            app:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/home_panel_top_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_close_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/collapse_panel"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="6dp"
            android:rotation="180"
            android:text=""
            app:icon="@drawable/ic_chevron_down_24"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="16dp" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.MapPanelGroupLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:text="@string/workflow_planning_mode"
        android:textColor="@color/ds_color_shell_unselected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_tab_height"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:background="@drawable/bg_preview_mode_rail"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/right_panel_area_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/area"
            android:textColor="@color/ds_color_shell_active"
            android:textSize="@dimen/phone_map_panel_label_text_size" />

        <TextView
            android:id="@+id/right_panel_points_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="2dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/points"
            android:textColor="@color/ds_color_text_primary"
            android:textSize="@dimen/phone_map_panel_label_text_size" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.MapPanelGroupLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:text="@string/workflow_geometry"
        android:textColor="@color/ds_color_shell_unselected" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_draw_area_button"
        style="@style/Widget.DroneServices.Button.MapLight"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:text="@string/draw_area"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        app:icon="@drawable/ic_draw_area_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconSize="20dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_add_home_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/set_home"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            android:visibility="gone"
            app:icon="@drawable/ic_home_takeoff_marker"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_clear_area_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:layout_weight="1"
            android:text="@string/clear_area"
            android:textColor="@color/ds_color_shell_danger"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            app:icon="@drawable/ic_delete_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp"
            app:iconTint="@color/ds_color_shell_danger" />
    </LinearLayout>

    <TextView
        android:id="@+id/right_panel_route_summary"
        style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:text="@string/route_summary_default"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ds_space_md"
        android:background="@color/ds_color_shell_stroke" />

    <TextView
        style="@style/TextAppearance.DroneServices.MapPanelGroupLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/workflow_mission"
        android:textColor="@color/ds_color_shell_unselected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_mission"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/save"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_load_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:layout_weight="1"
            android:text="@string/load"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            app:icon="@drawable/ic_folder_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.MapPanelGroupLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/workflow_tools"
        android:textColor="@color/ds_color_shell_unselected" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_weather_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/weather"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            app:icon="@drawable/ic_weather_wind_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_simulate_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:layout_weight="1"
            android:text="@string/simulate_mission_path"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            app:icon="@drawable/drone_marker_36"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconSize="18dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadMission"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/upload_mission"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        android:textStyle="bold"
        app:icon="@drawable/ic_upload_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconSize="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_resume_mission_button"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:text="@string/resume_mission"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
