<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:height="44dp" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#E61B252C" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="@color/ds_color_shell_stroke" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:height="44dp" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#3329E6DA" />
                <corners android:radius="22dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:height="44dp" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="#5529E6DA" />
                <corners android:radius="22dp" />
            </shape>
        </clip>
    </item>
</layer-list>
