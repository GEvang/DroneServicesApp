<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#E01A242C" />
            <stroke
                android:width="1dp"
                android:color="#9946F29C" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#E0141C24" />
            <stroke
                android:width="1dp"
                android:color="#7346F29C" />
        </shape>
    </item>
</selector>
