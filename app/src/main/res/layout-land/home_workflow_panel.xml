<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_workflow_panel"
    style="@style/Widget.DroneServices.Panel.MapRight"
    android:layout_width="@dimen/phone_map_panel_right_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_workflow_24"
            android:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/home_panel_top_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_close_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="^"
            android:textAllCaps="false"
            android:textSize="@dimen/phone_map_panel_title_text_size" />
    </LinearLayout>

    <TextView
        android:id="@+id/right_panel_area_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_md"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_md"
        android:text="@string/draw_area"
        android:textColor="@color/ds_color_text_primary"
        android:textSize="@dimen/phone_map_panel_label_text_size" />

    <TextView
        android:id="@+id/right_panel_points_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:paddingStart="@dimen/ds_space_md"
        android:paddingEnd="@dimen/ds_space_md"
        android:text="@string/points"
        android:textColor="@color/ds_color_text_primary"
        android:textSize="@dimen/phone_map_panel_label_text_size" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_draw_area_button"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_md"
        android:gravity="center"
        android:text="@string/draw_area"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        android:visibility="gone"
        app:icon="@drawable/ic_draw_area_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_clear_area_button"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        app:backgroundTint="@android:color/transparent"
        android:gravity="center"
        android:text="@string/clear_area"
        android:textColor="@color/ds_color_shell_danger"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        app:icon="@drawable/ic_delete_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_shell_danger"
        app:strokeColor="@color/ds_color_shell_danger" />

    <TextView
        android:id="@+id/right_panel_undo_route_button"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/undo_route_point"
        android:textColor="@color/ds_color_text_primary"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        android:visibility="gone" />

    <TextView
        android:id="@+id/right_panel_route_summary"
        style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/route_summary_default"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:background="@color/ds_color_shell_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_action_bolt_24"
            android:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/home_panel_operator_title"
            android:textColor="@color/ds_color_text_primary" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info_outline_16"
            android:tint="@color/ds_color_text_secondary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/save_mission"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/save"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        app:icon="@drawable/ic_save_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_load_button"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/load"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        app:icon="@drawable/ic_folder_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadMission"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height_tall"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:letterSpacing="0"
        android:text="@string/upload_mission"
        android:textSize="@dimen/phone_map_panel_label_text_size"
        android:textStyle="bold"
        app:icon="@drawable/ic_upload_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_shell_active" />
</LinearLayout>
