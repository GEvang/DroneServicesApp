<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.shell.MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:theme="@style/ThemeOverlay.AppCompat.Dark">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/customToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentInsetStart="0dp"
            android:contentInsetStartWithNavigation="0dp"
            android:contentInsetEnd="0dp"
            app:navigationIconTint="@color/text_primary"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark"
            app:titleTextAppearance="@style/Toolbar.TitleText">

            <LinearLayout
                android:id="@+id/hudBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/phone_map_hud_margin_horizontal"
                android:layout_marginTop="@dimen/phone_map_hud_margin_top"
                android:layout_marginEnd="@dimen/phone_map_hud_margin_horizontal"
                android:layout_marginBottom="@dimen/phone_map_hud_margin_bottom"
                android:background="@drawable/bg_hud_strip"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/phone_map_hud_padding_horizontal"
                android:paddingTop="@dimen/phone_map_hud_padding_vertical"
                android:paddingEnd="@dimen/phone_map_hud_padding_horizontal"
                android:paddingBottom="@dimen/phone_map_hud_padding_vertical">

                <ImageView
                    android:id="@+id/ivConnected"
                    android:layout_width="@dimen/phone_map_hud_icon_size"
                    android:layout_height="@dimen/phone_map_hud_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hud_connected"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/drone_connection_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.1"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/shell_status_connected"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_hud_divider" />

                <ImageView
                    android:id="@+id/ivGps"
                    android:layout_width="@dimen/phone_map_hud_icon_size"
                    android:layout_height="@dimen/phone_map_hud_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hud_gps"
                    app:tint="@android:color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.5"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gps_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="@string/shell_status_gps_placeholder"
                        android:textColor="@android:color/white"
                        android:textSize="@dimen/phone_map_hud_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/rtk_mountpoint_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/inter"
                        android:maxLines="1"
                        android:text="RTK Mountpoint: Not connected"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/phone_map_hud_text_size_small"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_hud_divider" />

                <TextView
                    android:id="@+id/drone_arm_text"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_weight="1.15"
                    android:background="@drawable/bg_hud_center_status"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/phone_map_hud_status_badge_padding_horizontal"
                    android:paddingEnd="@dimen/phone_map_hud_status_badge_padding_horizontal"
                    android:text="@string/disarmed"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_status_text_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_hud_divider" />

                <TextView
                    android:id="@+id/speed_status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/shell_status_speed_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_hud_divider" />

                <TextView
                    android:id="@+id/drone_alt_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.65"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:gravity="center"
                    android:maxLines="1"
                    android:text="@string/shell_status_alt_placeholder"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_hud_divider" />

                <ImageView
                    android:id="@+id/ivTank"
                    android:layout_width="@dimen/phone_map_hud_icon_size"
                    android:layout_height="@dimen/phone_map_hud_icon_size"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sprayer_image"
                    app:tint="@android:color/white" />

                <TextView
                    android:id="@+id/sprayer_flow_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:layout_weight="0.45"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/unknown_percentage"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/drone_battery_image"
                    android:layout_width="@dimen/phone_map_hud_icon_size"
                    android:layout_height="@dimen/phone_map_hud_icon_size"
                    android:layout_marginStart="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_baseline_battery_full_24" />

                <TextView
                    android:id="@+id/drone_battery_percentage_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="@string/unknown_percentage"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mission_upload_progress_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/inter"
                    android:maxLines="1"
                    android:text="Uploading 0%"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/phone_map_hud_text_size_small"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/appBarMain"
        android:fitsSystemWindows="true">

        <include layout="@layout/content_main" />
    </FrameLayout>
</RelativeLayout>
