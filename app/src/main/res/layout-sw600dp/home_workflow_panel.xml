<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_workflow_panel"
    style="@style/Widget.DroneServices.Panel.MapRight"
    android:layout_width="@dimen/tablet_right_panel_width"
    android:layout_height="wrap_content"
    android:maxWidth="352dp"
    android:minWidth="@dimen/tablet_right_panel_width"
    android:minHeight="@dimen/tablet_side_panel_min_height"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.DroneServices.MapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_panel_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_close_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="X"
            android:textAllCaps="false"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.PanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:text="@string/home_panel_mode_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/right_panel_survey_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_active"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/survey"
            android:textColor="@color/ds_color_shell_active"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/right_panel_spray_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_inactive"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/spray"
            android:textColor="@color/ds_color_text_primary" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.PanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:text="@string/home_panel_top_actions" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/right_panel_area_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_active"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/area"
            android:textColor="@color/ds_color_shell_active"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/right_panel_points_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_inactive"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/points"
            android:textColor="@color/ds_color_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/right_panel_draw_area_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/ds_space_md"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/draw_area"
        android:textColor="@color/ds_color_text_primary" />

    <TextView
        android:id="@+id/right_panel_clear_area_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/clear_area"
        android:textColor="@color/ds_color_text_primary" />

    <TextView
        android:id="@+id/right_panel_undo_route_button"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:background="@drawable/bg_ds_panel_pill_inactive"
        android:fontFamily="@font/inter"
        android:gravity="center"
        android:text="@string/undo_route_point"
        android:textColor="@color/ds_color_text_primary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/right_panel_route_summary"
        style="@style/TextAppearance.DroneServices.PanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/route_summary_default"
        android:visibility="gone" />

    <TextView
        style="@style/TextAppearance.DroneServices.PanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:text="@string/home_panel_operator_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_mission"
            style="@style/Widget.DroneServices.Button.MapLight"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="@string/save" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_load_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/load" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadMission"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:text="@string/upload_mission" />
</LinearLayout>
