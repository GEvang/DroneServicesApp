<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_workflow_panel"
    style="@style/Widget.DroneServices.Panel.MapRight"
    android:layout_width="@dimen/tablet_right_panel_width"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/tablet_right_panel_width"
    android:minWidth="@dimen/tablet_right_panel_width"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_map"
            android:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.MapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/home_panel_top_actions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_close_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            android:text="^"
            android:textAllCaps="false"
            android:textSize="@dimen/phone_map_panel_title_text_size" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/ds_space_md"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/right_panel_area_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_active"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/area"
            android:textColor="@color/ds_color_shell_active"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/right_panel_points_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ds_space_xs"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_panel_pill_inactive"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/points"
            android:textColor="@color/ds_color_text_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_draw_area_button"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/ds_space_md"
        android:gravity="center"
        android:text="@string/draw_area"
        app:icon="@drawable/ic_draw_area_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_text_primary" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/right_panel_clear_area_button"
        style="@style/Widget.DroneServices.Button.MapDark"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:gravity="center"
        android:text="@string/clear_area"
        app:icon="@drawable/ic_delete_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_text_primary" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:background="@color/ds_color_shell_stroke" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_action_bolt_24"
            android:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.PanelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:text="@string/home_panel_operator_title"
            android:textColor="@color/ds_color_text_primary" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:contentDescription="@null"
            android:src="@drawable/ic_info_outline_16"
            android:tint="@color/ds_color_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_mission"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/save"
            app:icon="@drawable/ic_save_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconTint="@color/ds_color_text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/right_panel_load_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/load"
            app:icon="@drawable/ic_folder_24"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/ds_space_xs"
            app:iconTint="@color/ds_color_text_primary" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uploadMission"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="@dimen/ds_space_lg"
        android:text="@string/upload_mission"
        android:textSize="16sp"
        android:textStyle="bold"
        android:letterSpacing="0"
        app:icon="@drawable/ic_upload_24"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/ds_space_sm"
        app:iconTint="@color/ds_color_shell_active" />
</LinearLayout>
