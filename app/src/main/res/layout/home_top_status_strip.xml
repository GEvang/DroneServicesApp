<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_top_status_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_status_bar"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/top_connection_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hud_connected"
                android:tint="@color/ds_color_shell_danger" />

            <TextView
                android:id="@+id/top_connection_text"
                style="@style/TextAppearance.DroneServices.MapStatusValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/shell_status_disconnected"
                android:textColor="@color/ds_color_shell_danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.65"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/top_gps_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hud_gps"
                android:tint="@color/ds_color_shell_danger" />

            <TextView
                android:id="@+id/top_gps_text"
                style="@style/TextAppearance.DroneServices.MapStatusValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="GPS: No GPS"
                android:textColor="@color/ds_color_shell_danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.85"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_hud_gps"
                android:tint="@color/ds_color_shell_unselected" />

            <TextView
                android:id="@+id/top_rtk_text"
                style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="RTK Mountpoint: Not connected"
                android:textColor="@color/ds_color_text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/top_armed_text"
            style="@style/TextAppearance.DroneServices.MapStatusValueLarge"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.25"
            android:background="@drawable/bg_map_status_card"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/disarmed"
            android:textColor="@color/ds_color_shell_warning" />

        <TextView
            android:id="@+id/top_speed_text"
            style="@style/TextAppearance.DroneServices.MapStatusMetric"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.05"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/shell_status_speed_placeholder" />

        <TextView
            android:id="@+id/top_altitude_text"
            style="@style/TextAppearance.DroneServices.MapStatusMetric"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.05"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/shell_status_alt_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.15"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:id="@+id/top_battery_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_baseline_battery_alert_24"
                android:tint="@color/ds_color_shell_unselected" />

            <TextView
                android:id="@+id/top_battery_text"
                style="@style/TextAppearance.DroneServices.MapStatusMetric"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="--.-V --%" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.35"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE GEO"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/top_live_geo_status_text"
                style="@style/TextAppearance.DroneServices.MapStatusValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="UNKNOWN"
                android:textColor="@color/gps_unknown_gray" />
        </LinearLayout>
    </LinearLayout>
</HorizontalScrollView>
