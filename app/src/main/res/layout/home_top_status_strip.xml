<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_top_status_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_map_status_bar">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/map_status_strip_padding_horizontal"
        android:paddingTop="@dimen/map_status_strip_padding_vertical"
        android:paddingEnd="@dimen/map_status_strip_padding_horizontal"
        android:paddingBottom="@dimen/map_status_strip_padding_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_weight="1.04"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:id="@+id/top_connection_icon"
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_signal_24"
                app:tint="@color/ds_color_shell_danger" />

            <TextView
                android:id="@+id/top_connection_text"
                style="@style/TextAppearance.DroneServices.MapStatusValueLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/shell_status_disconnected"
                android:textColor="@color/ds_color_shell_danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.08"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:id="@+id/top_gps_icon"
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_gps_pin_24"
                app:tint="@color/ds_color_shell_danger" />

            <TextView
                android:id="@+id/top_gps_text"
                style="@style/TextAppearance.DroneServices.MapStatusValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/top_status_no_gps"
                android:textColor="@color/ds_color_shell_danger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.48"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_rtk_24"
                app:tint="@color/ds_color_text_primary" />

            <TextView
                android:id="@+id/top_rtk_text"
                style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/top_status_rtk_disconnected"
                android:textColor="@color/ds_color_text_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.25"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:id="@+id/top_armed_icon"
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_shield_24"
                app:tint="@color/ds_color_shell_danger" />

            <TextView
                android:id="@+id/top_armed_text"
                style="@style/TextAppearance.DroneServices.MapStatusValueLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@string/disarmed"
                android:textColor="@color/ds_color_shell_warning" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/top_flight_mode_card"
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.18"
            android:background="@drawable/bg_map_status_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:id="@+id/top_flight_mode_icon"
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_flight_mode_24"
                app:tint="@color/ds_color_shell_active" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/flight_mode_short_label"
                    android:includeFontPadding="false"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/top_flight_mode_value"
                    style="@style/TextAppearance.DroneServices.MapStatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:includeFontPadding="false"
                    android:text="@string/shell_status_disconnected"
                    android:textColor="@color/ds_color_shell_active" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/top_flight_mode_progress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:indeterminateTint="@color/ds_color_shell_active"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/top_flight_mode_chevron"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_down_24"
                app:tint="@color/ds_color_shell_active" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="0.98"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_speed_24"
                app:tint="@color/ds_color_text_primary" />

            <TextView
                android:id="@+id/top_speed_text"
                style="@style/TextAppearance.DroneServices.MapStatusMetric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/top_status_speed_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="0.92"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_altitude_24"
                app:tint="@color/ds_color_text_primary" />

            <TextView
                android:id="@+id/top_altitude_text"
                style="@style/TextAppearance.DroneServices.MapStatusMetric"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/top_status_altitude_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.05"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:id="@+id/top_battery_icon"
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_baseline_battery_alert_24"
                app:tint="@color/ds_color_shell_unselected" />

            <TextView
                android:id="@+id/top_battery_text"
                style="@style/TextAppearance.DroneServices.MapStatusValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/top_status_battery_placeholder" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/map_status_card_height"
            android:layout_marginStart="@dimen/map_status_card_gap"
            android:layout_weight="1.22"
            android:background="@drawable/bg_map_status_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_status_card_padding_horizontal"
            android:paddingEnd="@dimen/map_status_card_padding_horizontal">

            <ImageView
                android:layout_width="@dimen/map_status_icon_size"
                android:layout_height="@dimen/map_status_icon_size"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_warning_24"
                app:tint="@color/ds_color_shell_warning" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/map_status_card_gap"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/top_status_live_geo"
                    android:textAllCaps="true" />

                <TextView
                    android:id="@+id/top_live_geo_status_text"
                    style="@style/TextAppearance.DroneServices.MapStatusValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/top_status_unknown"
                    android:textColor="@color/gps_unknown_gray" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
