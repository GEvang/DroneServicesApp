<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/more_screen_padding">

        <include android:id="@+id/settings_header" layout="@layout/view_more_tab_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_more_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/more_panel_padding">

                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/more_mission_defaults" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_mission_defaults_subtitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <ImageView
                            style="@style/Widget.DroneServices.MoreRowIcon"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_flight_mode_24" />
                        <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/mission_operation_mode_title" />
                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/settings_operation_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_more_field"
                            android:padding="2dp"
                            app:selectionRequired="true"
                            app:singleSelection="true">
                            <com.google.android.material.button.MaterialButton android:id="@+id/settings_spray_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="132dp" android:layout_height="44dp" android:text="@string/mission_operation_mode_spray" android:textAllCaps="false" android:textColor="@color/more_toggle_text" app:backgroundTint="@color/more_toggle_background" app:strokeColor="@color/ds_color_shell_active" app:strokeWidth="1dp" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/settings_mapping_button" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="132dp" android:layout_height="44dp" android:text="@string/mission_operation_mode_survey" android:textAllCaps="false" android:textColor="@color/more_toggle_text" app:backgroundTint="@color/more_toggle_background" app:strokeColor="@color/ds_color_shell_active" app:strokeWidth="1dp" />
                        </com.google.android.material.button.MaterialButtonToggleGroup>
                    </LinearLayout>
                    <TextView android:id="@+id/settings_operation_summary" android:layout_width="wrap_content" android:layout_height="0dp" android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/more_panel_gap"
                    android:background="@drawable/bg_more_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/more_panel_padding">
                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/locales_categ_pref" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_localization_subtitle" />
                    <LinearLayout android:id="@+id/settings_language_row" android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:contentDescription="@null" android:src="@drawable/ic_language_24" />
                        <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:layout_weight="1" android:text="@string/language" />
                        <TextView android:id="@+id/settings_language_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/more_panel_gap"
                    android:background="@drawable/bg_more_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/more_panel_padding">
                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_offline_maps" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_offline_maps_subtitle" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_database_24" />
                        <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/settings_cached_offline_maps" />
                        <TextView android:id="@+id/settings_cache_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/settings_clear_cache_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="12dp" android:text="@string/settings_clear_offline_cache" android:textColor="@color/ds_color_shell_danger" app:icon="@drawable/ic_delete_24" app:iconSize="20dp" app:iconTint="@color/ds_color_shell_danger" app:strokeColor="@color/ds_color_shell_danger" />
                </LinearLayout>
            </LinearLayout>

            <Space android:layout_width="@dimen/more_column_gap" android:layout_height="1dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_map_display" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_map_display_subtitle" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                        <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_menu_map" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_map_labels" />
                            <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_map_labels_description" />
                        </LinearLayout>
                        <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/settings_map_labels_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/more_panel_gap" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/settings_geo_data" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_geo_data_subtitle" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_database_24" android:drawablePadding="8dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/settings_dataset_source" />
                    <TextView android:id="@+id/settings_geo_source_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="@drawable/bg_more_divider" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_refresh_24" android:drawablePadding="8dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/settings_last_data_update" />
                    <TextView android:id="@+id/settings_geo_updated_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_status_warning_24" android:drawablePadding="8dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/settings_update_status" />
                    <TextView android:id="@+id/settings_geo_status_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_status_gps_pin_24" android:drawablePadding="8dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/settings_active_scope" />
                    <TextView android:id="@+id/settings_geo_scope_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
