<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_flight_mode_popup"
    android:elevation="14dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_flight_mode_24"
            app:tint="@color/ds_color_shell_active" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                style="@style/TextAppearance.DroneServices.BodyStrong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="@string/flight_mode_selector_title"
                android:textAllCaps="true"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/flight_mode_current_value"
                style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="@string/flight_mode_current_unknown" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_loiter_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_loiter"
            app:icon="@drawable/ic_flight_mode_24" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_auto_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_auto"
            app:icon="@drawable/ic_workflow_24" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_guided_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_guided"
            app:icon="@drawable/ic_baseline_my_location_48" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_brake_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_brake"
            android:textColor="@color/ds_color_shell_warning"
            app:icon="@drawable/ic_action_bolt_24"
            app:iconTint="@color/ds_color_shell_warning" />
    </LinearLayout>

    <TextView
        style="@style/TextAppearance.DroneServices.MapStatusSubvalue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/flight_mode_safety_actions"
        android:textAllCaps="true" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_rtl_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_rtl"
            android:textColor="@color/ds_color_shell_warning"
            app:icon="@drawable/ic_mode_rtl_24"
            app:iconTint="@color/ds_color_shell_warning" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/flight_mode_land_button"
            style="@style/Widget.DroneServices.Button.FlightModeTile"
            android:layout_width="0dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/flight_mode_land"
            android:textColor="@color/ds_color_shell_danger"
            app:icon="@drawable/ic_mode_land_24"
            app:iconTint="@color/ds_color_shell_danger" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/flight_mode_confirm_button"
        style="@style/Widget.DroneServices.Button.MapEmphasis"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="@string/flight_mode_rtl"
        android:textSize="12sp"
        android:visibility="gone"
        app:icon="@drawable/ic_status_shield_24"
        app:iconGravity="textStart"
        app:iconSize="18dp" />
</LinearLayout>
