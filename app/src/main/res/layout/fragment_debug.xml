<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_background"
    android:fillViewport="true"
    tools:context=".ui.debug.DebugFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_lg">

        <TextView
            style="@style/TextAppearance.DroneServices.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/debug_title" />

        <TextView
            style="@style/TextAppearance.DroneServices.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_xl"
            android:text="@string/debug_sprayer" />

        <TextView
            style="@style/TextAppearance.DroneServices.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/debug_sprayer_pwm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_sprayer_1000_button"
                style="@style/Widget.DroneServices.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/debug_sprayer_pwm_1000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_sprayer_1500_button"
                style="@style/Widget.DroneServices.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/debug_sprayer_pwm_1500" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_sprayer_2000_button"
                style="@style/Widget.DroneServices.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/debug_sprayer_pwm_2000" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/debug_sprayer_2200_button"
                style="@style/Widget.DroneServices.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/debug_sprayer_pwm_2200" />
        </LinearLayout>

        <TextView
            android:id="@+id/debug_sprayer_drone_value"
            style="@style/TextAppearance.DroneServices.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/debug_sprayer_drone_value_unknown" />
    </LinearLayout>
</ScrollView>
