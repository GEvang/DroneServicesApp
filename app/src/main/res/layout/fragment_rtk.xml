<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_background"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".ui.rtk.RtkFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_lg"
        android:paddingTop="@dimen/ds_space_lg"
        android:paddingEnd="@dimen/ds_space_lg"
        android:paddingBottom="@dimen/ds_space_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_overlay_card"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rtk_title"
                style="@style/TextAppearance.DroneServices.SectionTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:text="@string/rtk_console_subtitle"
                style="@style/TextAppearance.DroneServices.MapPanelSubtitle" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ds_shell_status_segment"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rtk_status"
                        style="@style/TextAppearance.DroneServices.StatusLabel" />

                    <TextView
                        android:id="@+id/rtk_status_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/rtk_status_idle"
                        style="@style/TextAppearance.DroneServices.StatusValue" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:background="@drawable/bg_ds_shell_status_segment"
                    android:orientation="vertical"
                    android:padding="@dimen/ds_space_md">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rtk_forwarding_status"
                        style="@style/TextAppearance.DroneServices.StatusLabel" />

                    <TextView
                        android:id="@+id/rtk_forwarding_status_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/rtk_forwarding_idle"
                        style="@style/TextAppearance.DroneServices.StatusValue" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_sm"
                android:background="@drawable/bg_ds_shell_status_segment"
                android:orientation="vertical"
                android:padding="@dimen/ds_space_md">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rtk_gps_debug_status"
                    style="@style/TextAppearance.DroneServices.StatusLabel" />

                <TextView
                    android:id="@+id/rtk_gps_debug_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_xs"
                    android:text="@string/rtk_gps_debug_default"
                    style="@style/TextAppearance.DroneServices.StatusValue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:background="@drawable/bg_ds_overlay_card"
            android:orientation="vertical"
            android:padding="@dimen/ds_space_lg">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rtk_connection_section_title"
                style="@style/TextAppearance.DroneServices.MapPanelTitle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:text="@string/rtk_keep_awake_hint"
                style="@style/TextAppearance.DroneServices.MapPanelSubtitle" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DroneServices.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_lg"
                android:hint="@string/rtk_ip">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtk_ip_input"
                    style="@style/Widget.DroneServices.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DroneServices.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:hint="@string/rtk_port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtk_port_input"
                    style="@style/Widget.DroneServices.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DroneServices.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:hint="@string/rtk_username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtk_username_input"
                    style="@style/Widget.DroneServices.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DroneServices.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:hint="@string/rtk_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtk_password_input"
                    style="@style/Widget.DroneServices.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.DroneServices.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_md"
                android:hint="@string/rtk_mountpoint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/rtk_mountpoint_input"
                    style="@style/Widget.DroneServices.TextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:longClickable="false"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_lg"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/fetch_mountpoints_button"
                    style="@style/Widget.DroneServices.Button.MapDark"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ds_compact_button_height"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/rtk_fetch_mountpoints" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/test_connection_button"
                    style="@style/Widget.DroneServices.Button.MapLight"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/ds_compact_button_height"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxLines="2"
                    android:text="@string/rtk_test_connection" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
