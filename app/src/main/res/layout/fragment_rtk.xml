<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ds_color_background" android:fillViewport="true" android:scrollbars="none">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/more_screen_padding">
  <include android:id="@+id/rtk_header" layout="@layout/view_more_tab_header" />
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rtk_caster_access" /><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/rtk_caster_access_subtitle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
     <com.google.android.material.textfield.TextInputLayout style="@style/Widget.DroneServices.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/rtk_ip" app:startIconDrawable="@drawable/ic_server_24" app:startIconTint="@android:color/white"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rtk_ip_input" style="@style/Widget.DroneServices.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textUri" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
     <com.google.android.material.textfield.TextInputLayout style="@style/Widget.DroneServices.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:hint="@string/rtk_port" app:startIconDrawable="@drawable/ic_menu_tune" app:startIconTint="@android:color/white"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rtk_port_input" style="@style/Widget.DroneServices.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
     <com.google.android.material.textfield.TextInputLayout style="@style/Widget.DroneServices.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:hint="@string/rtk_username" app:startIconDrawable="@drawable/ic_person_24" app:startIconTint="@android:color/white"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rtk_username_input" style="@style/Widget.DroneServices.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
     <com.google.android.material.textfield.TextInputLayout style="@style/Widget.DroneServices.TextInputLayout" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:hint="@string/rtk_password" app:endIconMode="password_toggle" app:startIconDrawable="@drawable/ic_lock_24" app:startIconTint="@android:color/white"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rtk_password_input" style="@style/Widget.DroneServices.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.DroneServices.TextInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:hint="@string/rtk_mountpoint" app:startIconDrawable="@drawable/ic_status_rtk_24" app:startIconTint="@android:color/white"><com.google.android.material.textfield.TextInputEditText android:id="@+id/rtk_mountpoint_input" style="@style/Widget.DroneServices.TextInputEditText" android:layout_width="match_parent" android:layout_height="wrap_content" android:focusable="false" android:singleLine="true" /></com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/fetch_mountpoints_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="@string/rtk_fetch_mountpoints" app:icon="@drawable/ic_points_24" app:iconSize="20dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/test_connection_button" style="@style/Widget.DroneServices.Button.Material.Primary" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="@string/rtk_test_connection" app:icon="@drawable/ic_status_rtk_24" app:iconSize="20dp" />
   </LinearLayout>
   <Space android:layout_width="@dimen/more_column_gap" android:layout_height="1dp" />
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
     <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_status_rtk_24" android:drawablePadding="10dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/rtk_connection_status" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
      <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_weight="1" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:orientation="vertical"><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rtk_status" /><TextView android:id="@+id/rtk_status_value" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" /></LinearLayout>
      <LinearLayout android:layout_width="0dp" android:layout_height="72dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:orientation="vertical"><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/rtk_forwarding_status" /><TextView android:id="@+id/rtk_forwarding_status_value" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:ellipsize="end" android:maxLines="1" /></LinearLayout>
     </LinearLayout>
     <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@drawable/bg_more_divider" />
     <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:drawableStart="@drawable/ic_status_gps_pin_24" android:drawablePadding="10dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/rtk_gps_diagnostics" />
     <TextView android:id="@+id/rtk_gps_debug_value" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_more_field" android:minHeight="86dp" android:gravity="center_vertical" />
     <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@drawable/bg_more_divider" />
     <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/rtk_base_coordinates" /><TextView android:id="@+id/rtk_base_coordinates_value" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
    </LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
