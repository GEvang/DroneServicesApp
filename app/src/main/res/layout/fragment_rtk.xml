<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.rtk.RtkFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rtk_title"
            style="@style/TextAppearance.DroneServices.Title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rtk_status"
            style="@style/TextAppearance.DroneServices.Caption" />

        <TextView
            android:id="@+id/rtk_status_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/rtk_status_idle"
            style="@style/Widget.DroneServices.TextView.StatusCard" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rtk_forwarding_status"
            style="@style/TextAppearance.DroneServices.Caption" />

        <TextView
            android:id="@+id/rtk_forwarding_status_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/rtk_forwarding_idle"
            style="@style/Widget.DroneServices.TextView.StatusCard" />

        <TextView
            android:id="@+id/rtk_keep_awake_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/rtk_keep_awake_hint"
            style="@style/TextAppearance.DroneServices.Caption" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rtk_gps_debug_status"
            style="@style/TextAppearance.DroneServices.Caption" />

        <TextView
            android:id="@+id/rtk_gps_debug_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/rtk_gps_debug_default"
            style="@style/Widget.DroneServices.TextView.StatusCard" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DroneServices.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/rtk_ip">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.DroneServices.TextInputEditText"
                android:id="@+id/rtk_ip_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DroneServices.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/rtk_port">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.DroneServices.TextInputEditText"
                android:id="@+id/rtk_port_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DroneServices.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/rtk_username">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.DroneServices.TextInputEditText"
                android:id="@+id/rtk_username_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DroneServices.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/rtk_password"
            app:endIconMode="password_toggle">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.DroneServices.TextInputEditText"
                android:id="@+id/rtk_password_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DroneServices.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/rtk_mountpoint">

            <com.google.android.material.textfield.TextInputEditText
                style="@style/Widget.DroneServices.TextInputEditText"
                android:id="@+id/rtk_mountpoint_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:longClickable="false"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.DroneServices.Button.Material.Primary"
            android:id="@+id/fetch_mountpoints_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/rtk_fetch_mountpoints" />

        <com.google.android.material.button.MaterialButton
            style="@style/Widget.DroneServices.Button.Material.Primary"
            android:id="@+id/test_connection_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/rtk_test_connection" />

    </LinearLayout>
</ScrollView>
