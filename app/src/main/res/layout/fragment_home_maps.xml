<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    tools:context=".ui.home.MissionMapFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/osmMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.example.droneservicesapp.ui.pointcloud.PointCloudGlView
        android:id="@+id/home_point_cloud_gl_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true">

        <include
            android:id="@+id/home_top_status_strip"
            layout="@layout/home_top_status_strip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/planning_panel_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/phone_map_overlay_card_margin"
            android:layout_marginEnd="@dimen/phone_map_overlay_card_margin"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/phone_map_panel_max_height"
            app:layout_constraintTop_toBottomOf="@id/home_top_status_strip"
            app:layout_constraintVertical_bias="0.0">

            <include
                android:id="@+id/home_workflow_panel_include"
                layout="@layout/home_workflow_panel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.core.widget.NestedScrollView>

        <include
            android:id="@+id/liveGeoAwarenessPanel"
            layout="@layout/view_live_geo_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/phone_map_overlay_card_margin"
            android:layout_marginBottom="@dimen/ds_space_sm"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/home_bottom_utility_dock"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/mission_params_side_view"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/phone_map_overlay_card_margin"
            android:layout_marginStart="@dimen/phone_map_overlay_card_margin"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/home_draw_action_bar"
            app:layout_constraintHeight_max="@dimen/phone_map_panel_max_height"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/home_top_status_strip"
            app:layout_constraintVertical_bias="1.0">

            <include
                android:id="@+id/home_left_panel"
                layout="@layout/mission_params_side_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/home_bottom_planning_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="78dp"
            android:background="@drawable/bg_bottom_dock"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="@string/planning"
            android:textColor="@android:color/white"
            android:textSize="@dimen/phone_map_hud_text_size"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/home_mission_summary_card"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="88dp"
            android:background="@drawable/bg_ds_overlay_card"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="3dp"
            android:minWidth="220dp"
            android:padding="12dp"
            android:textColor="@color/ds_color_text_primary"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/home_bottom_utility_dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/survey_waypoint_edit_dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="88dp"
            android:background="@drawable/bg_bottom_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingTop="@dimen/phone_map_bottom_dock_padding_vertical"
            android:paddingRight="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingBottom="@dimen/phone_map_bottom_dock_padding_vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/home_bottom_utility_dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/survey_waypoint_height_minus_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/survey_waypoint_height_decrease"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remove_24"
                android:tint="@android:color/white" />

            <TextView
                android:id="@+id/survey_waypoint_height_label"
                style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:layout_marginEnd="@dimen/phone_map_bottom_dock_item_spacing"
                android:minWidth="76dp"
                android:gravity="center"
                android:textColor="@color/ds_color_text_primary"
                tools:text="Alt 12 m" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/survey_waypoint_height_plus_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginEnd="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/survey_waypoint_height_increase"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add_24"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/survey_waypoint_delete_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/survey_waypoint_delete"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete_24"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/survey_waypoint_cancel_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/survey_waypoint_cancel"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_baseline_cancel_24"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_draw_action_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="68dp"
            android:background="@drawable/bg_bottom_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingTop="@dimen/phone_map_bottom_dock_padding_vertical"
            android:paddingRight="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingBottom="@dimen/phone_map_bottom_dock_padding_vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_draw_decline_button"
                style="@style/Widget.DroneServices.Button.MapDark"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/phone_map_draw_button_height"
                android:minWidth="@dimen/phone_map_draw_button_min_width"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/decline"
                android:textSize="@dimen/phone_map_draw_button_text_size" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/home_draw_accept_button"
                style="@style/Widget.DroneServices.Button.MapLight"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/phone_map_draw_button_height"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:minWidth="@dimen/phone_map_draw_button_min_width"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/accept"
                android:textSize="@dimen/phone_map_draw_button_text_size" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_bottom_utility_dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/phone_map_bottom_dock_margin_bottom"
            android:background="@drawable/bg_bottom_dock"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingTop="@dimen/phone_map_bottom_dock_padding_vertical"
            android:paddingRight="@dimen/phone_map_bottom_dock_padding_horizontal"
            android:paddingBottom="@dimen/phone_map_bottom_dock_padding_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_center_operator_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/my_location_button_desc"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_baseline_my_location_48"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_center_drone_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/drone_location_button"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/drone_marker_36"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_obstacles_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/forbidden_areas"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/obstacle"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_offset_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/map_dock_offset"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_map"
                android:tint="@android:color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/utility_planning_button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/phone_map_bottom_dock_button_height"
                android:layout_marginStart="@dimen/phone_map_bottom_dock_item_spacing"
                android:layout_marginEnd="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_mode_button"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:minWidth="@dimen/phone_map_bottom_dock_primary_min_width"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/planning"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/phone_map_bottom_dock_text_size"
                android:textStyle="bold"
                app:icon="@drawable/mission_planning"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="30dp"
                app:iconTint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_download_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_marginEnd="@dimen/phone_map_bottom_dock_item_spacing"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/home_offline_download"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:src="@android:drawable/stat_sys_download"
                android:tint="@android:color/white" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/utility_settings_button"
                android:layout_width="@dimen/phone_map_bottom_dock_icon_size"
                android:layout_height="@dimen/phone_map_bottom_dock_icon_size"
                android:background="@drawable/bg_bottom_dock_button"
                android:contentDescription="@string/menu_settings"
                android:padding="@dimen/phone_map_bottom_dock_icon_padding"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu_settings"
                android:tint="@android:color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/preview_mode_bottom_dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/phone_map_overlay_card_margin"
            android:layout_marginBottom="@dimen/preview_mode_rail_bottom_margin"
            android:background="@drawable/bg_preview_mode_rail"
            android:gravity="start"
            android:orientation="vertical"
            android:padding="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/preview_mode_switch_size"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/preview_mode_cycle_button"
                    android:layout_width="@dimen/preview_mode_switch_size"
                    android:layout_height="@dimen/preview_mode_switch_size"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/preview_mode_next_ortho"
                    android:elevation="10dp"
                    android:padding="@dimen/preview_mode_switch_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_ortho_24"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/preview_mode_cycle_label"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_sm"
                    android:text="@string/preview_mode_next_ortho"
                    android:textColor="@color/ds_color_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preview_asset_primary_row"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/preview_mode_switch_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/preview_asset_primary_button"
                    android:layout_width="@dimen/preview_mode_switch_size"
                    android:layout_height="@dimen/preview_mode_switch_size"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/ortho_load_image"
                    android:elevation="10dp"
                    android:padding="@dimen/preview_mode_switch_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/baseline_load_file_24"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/preview_asset_primary_label"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_sm"
                    android:text="@string/ortho_load_image"
                    android:textColor="@color/ds_color_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preview_asset_secondary_row"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/preview_mode_switch_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/preview_asset_secondary_button"
                    android:layout_width="@dimen/preview_mode_switch_size"
                    android:layout_height="@dimen/preview_mode_switch_size"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/ortho_load_world"
                    android:elevation="10dp"
                    android:padding="@dimen/preview_mode_switch_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_menu_map"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/preview_asset_secondary_label"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_sm"
                    android:text="@string/ortho_load_world"
                    android:textColor="@color/ds_color_text_primary" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/preview_color_mode_row"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/preview_mode_switch_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/preview_color_mode_button"
                    android:layout_width="@dimen/preview_mode_switch_size"
                    android:layout_height="@dimen/preview_mode_switch_size"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/preview_height_color_mode"
                    android:elevation="10dp"
                    android:padding="@dimen/preview_mode_switch_padding"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_survey_modified"
                    android:tint="@android:color/white" />

                <TextView
                    android:id="@+id/preview_color_mode_label"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/ds_space_sm"
                    android:text="@string/preview_height_color_mode"
                    android:textColor="@color/ds_color_text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/preview_terrain_status"
                style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ds_space_sm"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm"
                android:textColor="@color/ds_color_text_secondary"
                android:visibility="gone"
                tools:text="Terrain 120k" />
        </LinearLayout>

        <include
            layout="@layout/home_obstacle_panel"
            android:layout_width="@dimen/phone_map_panel_right_width"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/phone_map_overlay_card_margin"
            android:layout_marginBottom="@dimen/ds_space_sm"
            app:layout_constraintBottom_toTopOf="@id/home_bottom_utility_dock"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/home_telemetry_legacy_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/home_top_avoidance_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/front_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageView
                    android:id="@+id/avoidance_compass"
                    android:layout_width="1dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/back_dist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/save_file_layout"
        style="@style/Widget.DroneServices.Panel.MapCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/phone_map_overlay_card_margin"
        android:layout_marginEnd="@dimen/phone_map_overlay_card_margin"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.DroneServices.MapPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="@dimen/ds_space_md"
            android:background="@drawable/bg_slider_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="@dimen/ds_space_md"
            android:paddingRight="@dimen/ds_space_md">

            <TextView
                style="@style/TextAppearance.DroneServices.PanelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="@dimen/ds_space_sm"
                android:text="@string/name"
                tools:ignore="RtlSymmetry" />

            <EditText
                android:id="@+id/input_filename"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:clickable="true"
                android:cursorVisible="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="@string/enter_text"
                android:imeOptions="actionDone"
                android:inputType="textShortMessage"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="16sp"
                android:fontFamily="@font/inter" />

            <TextView
                style="@style/TextAppearance.DroneServices.PanelLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="@dimen/ds_space_sm"
                android:text="@string/DroneServicesFilePageSuffix"
                tools:ignore="RtlHardcoded,RtlSymmetry" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/override_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/ds_color_shell_active" />

            <TextView
                style="@style/TextAppearance.DroneServices.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:text="@string/override_existing_file" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_button"
                style="@style/Widget.DroneServices.Button.MapDark"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_button"
                style="@style/Widget.DroneServices.Button.MapEmphasis"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:text="@string/save" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/load_file_selector_layout"
        style="@style/Widget.DroneServices.Panel.MapCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/phone_map_overlay_card_margin"
        android:layout_marginEnd="@dimen/phone_map_overlay_card_margin"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/TextAppearance.DroneServices.MapPanelTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/load" />

        <ListView
            android:id="@+id/file_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:background="@drawable/bg_slider_pill"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@drawable/drawer_nav_item_background"
            android:paddingTop="@dimen/ds_space_sm"
            android:paddingBottom="@dimen/ds_space_sm" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel"
                style="@style/Widget.DroneServices.Button.MapDark"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="@string/cancel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_confirm_load"
                style="@style/Widget.DroneServices.Button.MapEmphasis"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:text="@string/ok" />
        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
