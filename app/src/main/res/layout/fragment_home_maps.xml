<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.MissionMapFragment"
    android:background="@color/bg">

    <org.osmdroid.views.MapView
        android:id="@+id/osmMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true">

        <!-- My location -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.DroneServices.Fab.Overlay"
            android:id="@+id/my_location_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:contentDescription="@string/my_location_button_desc"
            android:focusable="true"
            android:src="@drawable/ic_baseline_my_location_48"
            />

        <!-- Drone location -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.DroneServices.Fab.Overlay"
            android:id="@+id/drone_location_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/my_location_button"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:contentDescription="@string/drone_location_button"
            android:focusable="true"
            android:src="@drawable/drone_marker_36"
            />

        <!-- Download offline -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            style="@style/Widget.DroneServices.Fab.Overlay"
            android:id="@+id/download_offline_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/drone_location_button"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:clickable="true"
            android:contentDescription="Download offline area"
            android:focusable="true"
            android:src="@android:drawable/stat_sys_download"
            />

        <include
            android:id="@+id/mission_params_side_view"
            layout="@layout/mission_params_side_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp" />

    </RelativeLayout>

    <!-- SAVE FILE PANEL -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/save_file_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_card_gold_stroke"
        android:padding="@dimen/ds_space_lg"
        android:visibility="gone">

        <!-- (content unchanged) -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingEnd="8dp"
                android:text="@string/name"
                style="@style/TextAppearance.DroneServices.Caption"
                tools:ignore="RtlSymmetry" />

            <EditText
                android:id="@+id/input_filename"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxWidth="200dp"
                android:hint="@string/enter_text"
                android:autofillHints="Insert the file name here"
                android:inputType="textShortMessage"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:fontFamily="@font/inter"
                android:backgroundTint="@color/accent_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="8dp"
                android:text="@string/waypoints"
                style="@style/TextAppearance.DroneServices.Caption"
                tools:ignore="RtlHardcoded,RtlSymmetry" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <CheckBox
                android:id="@+id/override_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/accent_gold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/override_existing_file"
                style="@style/TextAppearance.DroneServices.Caption"
                android:layout_marginStart="8dp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                style="@style/Widget.DroneServices.Button.Primary"
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/save" />

            <Button
                style="@style/Widget.DroneServices.Button.Secondary"
                android:id="@+id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_marginStart="12dp" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <!-- LOAD FILE PANEL -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/load_file_selector_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_card_gold_stroke"
        android:padding="@dimen/ds_space_lg"
        android:visibility="gone">

        <!-- (content unchanged) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_a_file"
            style="@style/TextAppearance.DroneServices.BodyStrong"
            android:textSize="18sp" />

        <ListView
            android:id="@+id/file_list"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:divider="@null"
            android:dividerHeight="0dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                style="@style/Widget.DroneServices.Button.Secondary"
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel" />

            <Button
                style="@style/Widget.DroneServices.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/ok" />
        </LinearLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

</FrameLayout>
