<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_header_height"
    android:orientation="vertical"
    android:gravity="bottom"
    android:paddingLeft="@dimen/ds_space_lg"
    android:paddingTop="@dimen/ds_space_lg"
    android:paddingRight="@dimen/ds_space_lg"
    android:paddingBottom="@dimen/ds_space_lg"
    android:background="@android:color/transparent">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="136dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/nav_header_desc"
        android:scaleType="fitCenter"
        android:src="@drawable/new_logo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:text="@string/drone_services_sprayer"
        style="@style/TextAppearance.DroneServices.BodyStrong"
        android:textSize="@dimen/ds_shell_header_title_size" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:text="@string/shell_operator_console"
        android:textColor="@color/ds_color_shell_unselected"
        android:textSize="@dimen/ds_shell_header_subtitle_size"
        android:fontFamily="@font/inter" />

    <View
        android:layout_width="48dp"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:background="@color/ds_color_shell_active"/>
</LinearLayout>
