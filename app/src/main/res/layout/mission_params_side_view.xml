<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mission_params_side_view"
    android:layout_width="wrap_content"
    android:minWidth="320dp"
    android:maxWidth="420dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_panel_flat"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- ===== Row template: title/value on top, pill slider below ===== -->

    <!-- ========= PARAM: Mission Angle ========= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <!-- Title + value (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/mission_angle"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/inter" />

            <!-- keep EditText ID (controller uses it), but visually act like a value label -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/line_angle_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:background="@null"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="end"
                    android:text="@string/unknown_value_three_questionmarks"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/degrees"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>

        <!-- Slider pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_slider_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:focusable="false">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_angle_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/decrease" />
            </FrameLayout>

            <com.example.droneservicesapp.ui.widgets.TouchDelegateSeekBar
                android:id="@+id/line_angle_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="90"
                android:progress="0"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress_dji"
                android:thumb="@drawable/seekbar_thumb_dji"
                android:minHeight="15dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_angle_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/increase" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========= PARAM: Line Distance ========= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/line_distance"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/inter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/line_distance_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:background="@null"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="end"
                    android:text="@string/unknown_value_three_questionmarks"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/m"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_slider_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:focusable="false">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_distance_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/decrease" />
            </FrameLayout>

            <com.example.droneservicesapp.ui.widgets.TouchDelegateSeekBar
                android:id="@+id/line_distance_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:min="2"
                android:progress="10"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress_dji"
                android:thumb="@drawable/seekbar_thumb_dji"
                android:minHeight="15dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_distance_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/increase" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========= PARAM: Altitude ========= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/flight_altitude"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/inter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/altitude_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:background="@null"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="end"
                    android:text="@string/unknown_value_three_questionmarks"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/m"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_slider_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:clickable="false"
            android:focusable="false">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_alt_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/decrease" />
            </FrameLayout>

            <com.example.droneservicesapp.ui.widgets.TouchDelegateSeekBar
                android:id="@+id/altitude_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="20"
                android:min="2"
                android:progress="5"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress_dji"
                android:thumb="@drawable/seekbar_thumb_dji"
                android:minHeight="15dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_alt_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/increase" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========= PARAM: Sprayer Intensity ========= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sprayer_intensity"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:fontFamily="@font/inter" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/sprayer_seekbar_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="44dp"
                    android:background="@null"
                    android:inputType="none"
                    android:focusable="false"
                    android:cursorVisible="false"
                    android:gravity="end"
                    android:text="@string/unknown_value_three_questionmarks"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="@font/inter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/percentage_symbol"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="@font/inter" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_slider_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_sprayer_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/decrease" />
            </FrameLayout>

            <com.example.droneservicesapp.ui.widgets.TouchDelegateSeekBar
                android:id="@+id/sprayer_seekbar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="100"
                android:progress="0"
                android:splitTrack="false"
                android:progressDrawable="@drawable/seekbar_progress_dji"
                android:thumb="@drawable/seekbar_thumb_dji"
                android:minHeight="15dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp" />

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center">
                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_sprayer_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/increase" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ========= Speed / time row (kept compact) ========= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/flight_time"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/inter" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_slider_pill"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/minus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:padding="0dp"
            android:background="@drawable/bg_slider_end_button"
            android:text="−"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:gravity="center"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/flight_speed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/unknown_value"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/inter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/meters_per_second"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter" />

        <Button
            android:id="@+id/plus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:padding="0dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_slider_end_button"
            android:text="+"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:gravity="center"
            android:fontFamily="@font/inter"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/flight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/unknown_value"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/inter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/mins"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/inter" />
    </LinearLayout>

    <!-- ========= Actions ========= -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/save_mission"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:text="Save"
                android:fontFamily="@font/inter" />

            <Button
                android:id="@+id/exit"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/exit"
                android:fontFamily="@font/inter" />
        </LinearLayout>

        <Button
            android:id="@+id/uploadMission"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:text="@string/upload_mission"
            android:fontFamily="@font/inter" />
    </LinearLayout>

</androidx.appcompat.widget.LinearLayoutCompat>