                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <TextView
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/m" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_terrain_segment_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/survey_canopy_smoothing" />

            <LinearLayout
                android:id="@+id/survey_canopy_smoothing_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_canopy_smoothing_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
