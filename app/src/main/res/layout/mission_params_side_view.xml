                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_terrain_segment_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/survey_terrain_segment_seekbar"
