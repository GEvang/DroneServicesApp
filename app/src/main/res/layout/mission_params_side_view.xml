                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="30"
                    android:progress="5"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

