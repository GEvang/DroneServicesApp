                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/m" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_canopy_smoothing_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/flight_time_label"
        style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:text="@string/flight_time"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/speed_time_row"
        android:layout_width="match_parent"
        android:layout_height="@dimen/phone_map_panel_button_height"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:background="@drawable/bg_slider_pill"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ds_space_sm"
        android:paddingEnd="@dimen/ds_space_sm"
        android:visibility="gone">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/minus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_icon_button_neutral"
            android:contentDescription="@string/decrease"
            android:padding="5dp"
            android:src="@drawable/ic_remove_24"
            android:tint="@color/text_secondary" />

        <TextView
            android:id="@+id/flight_speed"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:text="@string/unknown_value" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:text="@string/meters_per_second" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/plus_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:background="@drawable/bg_icon_button_neutral"
            android:contentDescription="@string/increase"
