<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mission_params_left_panel"
    style="@style/Widget.DroneServices.Panel.MapLeft"
    android:layout_width="@dimen/phone_map_panel_left_width"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/home_panel_flight_settings" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelTitle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="^"
            android:textColor="@color/ds_color_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/spray_mode_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_map_panel_tab_height"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/altitude_reference_relative_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_panel_pill_active"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/relative"
                android:textColor="@color/ds_color_shell_selected_content"
                android:textSize="@dimen/phone_map_panel_label_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/altitude_reference_terrain_button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/ds_space_xs"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_panel_pill_inactive"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:text="@string/terrain"
                android:textColor="@color/ds_color_text_primary"
                android:textSize="@dimen/phone_map_panel_label_text_size" />
        </LinearLayout>

        <TextView
            android:id="@+id/altitude_reference_warning"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/terrain_altitude_warning"
            android:textColor="@color/ds_color_shell_warning"
            android:visibility="gone" />

        <TextView
            android:id="@+id/spray_preset_selector"
            android:layout_width="match_parent"
            android:layout_height="@dimen/phone_map_panel_button_height"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:background="@drawable/bg_ds_panel_pill_inactive"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:text="@string/preset_dakos"
            android:textColor="@color/ds_color_text_primary"
            android:textSize="@dimen/phone_map_panel_label_text_size"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/mission_angle" />

            <LinearLayout
                android:id="@+id/angle_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_angle_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/line_angle_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="180"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/line_angle_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_angle_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/line_distance" />

            <LinearLayout
                android:id="@+id/line_distance_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_distance_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/line_distance_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="20"
                    android:min="0"
                    android:progress="10"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/line_distance_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_distance_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/flight_altitude" />

            <LinearLayout
                android:id="@+id/altitude_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_alt_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/altitude_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="20"
                    android:min="0"
                    android:progress="5"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/altitude_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_alt_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/spray_liters" />

            <LinearLayout
                android:id="@+id/sprayer_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_sprayer_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/sprayer_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/sprayer_seekbar_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_sprayer_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/survey_mode_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/survey_grid_section_label"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="@string/survey_grid_title"
            android:textAllCaps="true"
            android:textColor="@color/ds_color_shell_active" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/ds_space_xs"
            android:background="@color/ds_color_shell_active" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/survey_strip_spacing" />

            <LinearLayout
                android:id="@+id/survey_strip_spacing_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_strip_spacing_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/survey_strip_spacing_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="50"
                    android:min="2"
                    android:progress="8"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/survey_strip_spacing_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <TextView
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/m" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_strip_spacing_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/survey_height_above_terrain" />

            <LinearLayout
                android:id="@+id/survey_height_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_height_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/survey_height_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="120"
                    android:min="0"
                    android:progress="5"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/survey_height_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <TextView
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/m" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_height_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/survey_overlap" />

            <LinearLayout
                android:id="@+id/survey_overlap_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_overlap_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/survey_overlap_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="95"
                    android:progress="20"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
                    android:splitTrack="false"
                    android:thumb="@drawable/seekbar_thumb_dji" />

                <EditText
                    android:id="@+id/survey_overlap_value"
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:gravity="end"
                    android:inputType="none"
                    android:text="@string/unknown_value_three_questionmarks" />

                <TextView
                    style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/percentage_symbol" />

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_overlap_plus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/ds_space_sm"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/increase"
                    android:padding="5dp"
                    android:src="@drawable/ic_add_24"
                    android:tint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:orientation="vertical">

            <TextView
                style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/survey_grid_angle" />

            <LinearLayout
                android:id="@+id/survey_grid_angle_slider_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/phone_map_panel_slider_row_height"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:background="@drawable/bg_slider_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ds_space_sm"
                android:paddingEnd="@dimen/ds_space_sm">

                <androidx.appcompat.widget.AppCompatImageButton
                    android:id="@+id/btn_survey_grid_angle_minus"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_icon_button_neutral"
                    android:contentDescription="@string/decrease"
                    android:padding="5dp"
                    android:src="@drawable/ic_remove_24"
                    android:tint="@color/text_secondary" />

                <com.example.droneservicesapp.ui.common.TouchDelegateSeekBar
                    android:id="@+id/survey_grid_angle_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="@dimen/ds_space_xs"
                    android:layout_marginEnd="@dimen/ds_space_xs"
                    android:layout_weight="1"
                    android:max="180"
                    android:progress="0"
                    android:progressDrawable="@drawable/seekbar_progress_dji"
