<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_background">

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/more_screen_padding">
            <include android:id="@+id/geo_awareness_header" layout="@layout/view_more_tab_header" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                        <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/more_system_status" />
                        <TextView android:id="@+id/geo_awareness_health_chip" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_more_chip" android:drawableStart="@drawable/ic_status_warning_24" android:drawablePadding="8dp" android:drawableTint="@color/ds_color_shell_warning" android:gravity="center_vertical" android:text="@string/geo_awareness_health_unavailable" />
                        <TextView android:id="@+id/geo_awareness_health_message" style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_status_gps_pin_24" />
                            <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/geo_awareness_live_status" />
                            <TextView android:id="@+id/geo_awareness_live_status_chip" style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="16dp" android:background="@drawable/bg_more_chip" />
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_layers_24" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/geo_awareness_overlay_section" />
                                <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/geo_awareness_show_zones" />
                            </LinearLayout>
                            <androidx.appcompat.widget.SwitchCompat android:id="@+id/geo_awareness_overlay_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/more_panel_gap" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                        <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/geo_awareness_dataset_source_section" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_database_24" />
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/geo_awareness_current_source_label" />
                                <TextView android:id="@+id/geo_awareness_current_source" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" />
                            </LinearLayout>
                        </LinearLayout>
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" />
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                            <TextView android:id="@+id/geo_awareness_loaded_datasets_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                            <TextView android:id="@+id/geo_awareness_total_zones_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                            <TextView android:id="@+id/geo_awareness_total_validation_summary" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_import_dataset_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="@string/geo_awareness_import_dataset" app:icon="@drawable/baseline_load_file_24" app:iconSize="20dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_reset_dataset_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/geo_awareness_reset_dataset" android:textColor="@color/ds_color_shell_danger" app:icon="@drawable/ic_delete_24" app:iconSize="20dp" app:iconTint="@color/ds_color_shell_danger" app:strokeColor="@color/ds_color_shell_danger" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_refresh_status_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="@string/geo_awareness_refresh_status" app:icon="@drawable/ic_refresh_24" app:iconSize="20dp" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/more_panel_gap" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                        <TextView android:id="@+id/geo_awareness_internal_section_title" style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/more_internal_tools" />
                        <LinearLayout android:id="@+id/geo_awareness_internal_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical" android:orientation="horizontal">
                            <ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_shield_lock_24" />
                            <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/geo_awareness_internal_logs_notice" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_export_encrypted_incidents_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:text="@string/geo_awareness_export_encrypted_incidents" app:icon="@drawable/ic_upload_24" app:iconSize="20dp" />
                    </LinearLayout>
                </LinearLayout>

                <Space android:layout_width="@dimen/more_column_gap" android:layout_height="1dp" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_more_panel" android:minHeight="250dp" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
                    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/ic_database_24" android:drawablePadding="10dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/geo_awareness_loaded_datasets_section" />
                    <LinearLayout android:id="@+id/geo_awareness_dataset_records_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:minHeight="170dp" android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/geo_awareness_notice_section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/geo_awareness_validation_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/geo_awareness_validation_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <TextView android:id="@+id/geo_awareness_validation_counts" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_validation_details_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:id="@+id/geo_awareness_flight_logs_section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/geo_awareness_flight_logs_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <LinearLayout android:id="@+id/geo_awareness_flight_log_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_view_detailed_logs_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_export_evidence_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
                <TextView android:id="@+id/geo_awareness_logs_section_title" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <LinearLayout android:id="@+id/geo_awareness_logs_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:id="@+id/geo_awareness_log_count" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_export_logs_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/geo_awareness_clear_logs_button" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/geo_awareness_loading_overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#B0000000" android:clickable="true" android:gravity="center" android:orientation="vertical" android:visibility="gone">
        <ProgressBar android:layout_width="48dp" android:layout_height="48dp" android:indeterminateTint="@color/ds_color_shell_active" />
        <TextView android:id="@+id/geo_awareness_loading_text" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
