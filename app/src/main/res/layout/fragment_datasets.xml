     </LinearLayout>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
      <com.google.android.material.button.MaterialButton android:id="@+id/dataset_rename_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="@string/dataset_rename" app:icon="@drawable/ic_menu_tune" app:iconSize="20dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/dataset_delete_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/dataset_delete" android:textColor="@color/ds_color_shell_danger" app:icon="@drawable/ic_delete_24" app:iconSize="20dp" app:iconTint="@color/ds_color_shell_danger" app:strokeColor="@color/ds_color_shell_danger" />
      <com.google.android.material.button.MaterialButton android:id="@+id/dataset_delete_all_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/dataset_delete_all" android:textColor="@color/ds_color_shell_danger" app:icon="@drawable/ic_delete_24" app:iconSize="20dp" app:iconTint="@color/ds_color_shell_danger" app:strokeColor="@color/ds_color_shell_danger" />
     </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/dataset_assets_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/more_panel_gap" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
     <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dataset_assets" />
     <TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_dataset_assets_subtitle" />
     <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="12dp" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_ortho_24" app:tint="@color/ds_color_text_primary" /><TextView android:id="@+id/dataset_ortho_image_status" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/dataset_load_tif_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="150dp" android:layout_height="44dp" android:text="@string/ortho_load_image" /></LinearLayout>
     <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="8dp" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_folder_24" app:tint="@color/ds_color_text_primary" /><TextView android:id="@+id/dataset_ortho_world_status" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/dataset_load_tfw_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="150dp" android:layout_height="44dp" android:text="@string/ortho_load_world" /></LinearLayout>
     <LinearLayout android:layout_width="match_parent" android:layout_height="70dp" android:layout_marginTop="8dp" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:orientation="horizontal"><ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_point_cloud_24" app:tint="@color/ds_color_text_primary" /><TextView android:id="@+id/dataset_point_cloud_status" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/dataset_load_ply_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="150dp" android:layout_height="44dp" android:text="@string/point_cloud_load" /></LinearLayout>
     <TextView android:id="@+id/dataset_loading_status" style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:visibility="gone" />
     <ProgressBar android:id="@+id/dataset_loading_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="4dp" android:layout_marginTop="6dp" android:progressTint="@color/ds_color_shell_active" android:visibility="gone" />
     <com.google.android.material.button.MaterialButton android:id="@+id/dataset_loading_cancel_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:text="@android:string/cancel" android:visibility="gone" />
    </LinearLayout>
   </LinearLayout>
   <Space android:layout_width="@dimen/more_column_gap" android:layout_height="1dp" />
   <LinearLayout android:id="@+id/dataset_display_options_card" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.92" android:background="@drawable/bg_more_panel" android:orientation="vertical" android:padding="@dimen/more_panel_padding">
    <TextView style="@style/TextAppearance.DroneServices.MorePanelTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/dataset_display_options" /><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/more_display_options_subtitle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_ortho_24" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ortho_background" /><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/more_background_subtitle" /></LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/dataset_ortho_background_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" /><TextView android:id="@+id/dataset_ortho_opacity_label" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_opacity_24" android:drawablePadding="12dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" /><com.google.android.material.slider.Slider android:id="@+id/dataset_ortho_opacity_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="0" android:valueTo="1" android:stepSize="0.05" app:trackColorActive="@color/ds_color_shell_active" app:thumbColor="@color/ds_color_shell_active" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" /><TextView android:id="@+id/dataset_point_size_label" style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_menu_tune" android:drawablePadding="12dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" /><com.google.android.material.slider.Slider android:id="@+id/dataset_point_size_slider" android:layout_width="match_parent" android:layout_height="wrap_content" android:valueFrom="1" android:valueTo="10" android:stepSize="0.5" app:trackColorActive="@color/ds_color_shell_active" app:thumbColor="@color/ds_color_shell_active" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/bg_more_divider" /><TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:drawableStart="@drawable/ic_layers_24" android:drawablePadding="12dp" android:drawableTint="@color/ds_color_text_primary" android:gravity="center_vertical" android:text="@string/point_cloud_detail" /><Spinner android:id="@+id/dataset_point_detail_selector" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@drawable/bg_more_field" android:gravity="center_vertical" android:popupBackground="@color/ds_color_surface_elevated" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:background="@drawable/bg_more_divider" /><LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/more_row_min_height" android:gravity="center_vertical" android:orientation="horizontal"><ImageView style="@style/Widget.DroneServices.MoreRowIcon" android:layout_marginEnd="12dp" android:contentDescription="@null" android:src="@drawable/ic_layers_24" /><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView style="@style/TextAppearance.DroneServices.MoreRowTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/preview_height_color_mode" /><TextView style="@style/TextAppearance.DroneServices.MoreRowSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/more_height_colors_subtitle" /></LinearLayout><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/dataset_height_colors_switch" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
   </LinearLayout>
  </LinearLayout>
 </LinearLayout>
</ScrollView>
