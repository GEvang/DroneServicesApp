      <com.google.android.material.button.MaterialButton android:id="@+id/dataset_load_button" style="@style/Widget.DroneServices.Button.Material.Secondary" android:layout_width="0dp" android:layout_height="48dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="@string/dataset_load" app:icon="@drawable/ic_folder_24" app:iconSize="20dp" />
