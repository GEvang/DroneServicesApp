<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_color_background"
    tools:context=".ui.ortho.OrthoPreviewFragment">

    <org.osmdroid.views.MapView
        android:id="@+id/ortho_map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/mission_params_side_view"
        android:layout_width="@dimen/phone_map_panel_left_width"
        android:layout_height="@dimen/phone_map_panel_max_height"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/phone_map_overlay_card_margin"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="vertical"
        android:visibility="gone">

        <include
            layout="@layout/mission_params_side_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/ortho_asset_panel"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/ds_space_lg"
        android:background="@drawable/bg_ds_overlay_card"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_md">

        <TextView
            android:id="@+id/ortho_status_text"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ds_color_text_primary"
            tools:text="Load an ortho image and world file" />

        <TextView
            android:id="@+id/ortho_stats_text"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:textColor="@color/ds_color_text_secondary"
            tools:text="Image: --" />

        <ProgressBar
            android:id="@+id/ortho_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:indeterminate="true"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ortho_load_image_button"
                style="@style/Widget.DroneServices.Button.MapLight"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ortho_load_image" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ortho_load_world_button"
                style="@style/Widget.DroneServices.Button.MapDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_sm"
                android:layout_weight="1"
                android:text="@string/ortho_load_world" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ortho_clear_button"
            style="@style/Widget.DroneServices.Button.MapDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:text="@string/ortho_clear" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ortho_zoom_to_button"
                style="@style/Widget.DroneServices.Button.MapDark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ortho_zoom_to" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/ortho_background_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_md"
                android:checked="true"
                android:text="@string/ortho_background"
                android:textColor="@color/ds_color_text_secondary" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_md"
            android:text="@string/ortho_opacity"
            android:textColor="@color/ds_color_text_secondary" />

        <com.google.android.material.slider.Slider
            android:id="@+id/ortho_opacity_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="0.85"
            android:valueFrom="0"
            android:valueTo="1"
            android:stepSize="0.05" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ortho_bottom_utility_dock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/phone_map_overlay_card_margin"
        android:layout_marginBottom="@dimen/preview_mode_rail_bottom_margin"
        android:background="@drawable/bg_preview_mode_rail"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/ortho_preview_cycle_button"
            android:layout_width="@dimen/preview_mode_switch_size"
            android:layout_height="@dimen/preview_mode_switch_size"
            android:background="@android:color/transparent"
            android:contentDescription="@string/preview_mode_next_3d"
            android:elevation="10dp"
            android:padding="@dimen/preview_mode_switch_padding"
            android:scaleType="centerInside"
            android:src="@drawable/ic_point_cloud_24"
            android:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
