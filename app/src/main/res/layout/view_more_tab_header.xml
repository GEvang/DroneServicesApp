<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="14dp">

    <FrameLayout
        android:layout_width="@dimen/more_icon_size"
        android:layout_height="@dimen/more_icon_size"
        android:background="@drawable/bg_more_icon_circle">

        <ImageView
            android:id="@+id/more_header_icon"
            android:layout_width="@dimen/more_icon_glyph_size"
            android:layout_height="@dimen/more_icon_glyph_size"
            android:layout_gravity="center"
            android:contentDescription="@null"
            app:tint="@color/ds_color_text_primary"
            tools:src="@drawable/ic_menu_settings" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/more_header_title"
            style="@style/TextAppearance.DroneServices.MoreTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="Settings" />

        <TextView
            android:id="@+id/more_header_subtitle"
            style="@style/TextAppearance.DroneServices.MoreSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            tools:text="Mission, display and data preferences" />
    </LinearLayout>
</LinearLayout>
