<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/wind_weather_panel"
    style="@style/Widget.DroneServices.Panel.MapCard"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_weather_wind_24"
            app:tint="@color/ds_color_shell_active" />

        <TextView
            style="@style/TextAppearance.DroneServices.PhoneMapPanelTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:text="@string/weather" />

        <TextView
            android:id="@+id/wind_weather_status"
            style="@style/TextAppearance.DroneServices.PhoneMapPanelLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weather_loading"
            android:textColor="@color/ds_color_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_sm"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wind_weather_direction_arrow"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/weather_wind_direction"
            android:src="@drawable/ic_wind_direction_48"
            app:tint="@color/ds_color_shell_active" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_space_sm"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wind_weather_direction"
                style="@style/TextAppearance.DroneServices.PhoneMapPanelValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/weather_loading"
                android:textColor="@color/ds_color_text_primary" />

            <TextView
                android:id="@+id/wind_weather_speed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/inter"
                android:text="--"
                android:textColor="@color/ds_color_shell_active"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
